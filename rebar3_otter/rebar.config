{erl_opts, [debug_info]}.

%% otter's NIF runtime floor is OTP 26 (NIF 2.17). The plugin builds on the
%% same floor — it no longer depends on the OTP-27-only stdlib `json` module
%% (artifact paths are computed by convention, not parsed from cargo's JSON).
{minimum_otp_vsn, "26"}.

{deps, [
  {rebar, {git_subdir, "https://github.com/erlang/rebar3.git", {tag, "3.27.0"}, "apps"}}
]}.
